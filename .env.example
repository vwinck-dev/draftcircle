# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME="DraftCircle"
APP_DESCRIPTION="A social writing platform where authors create, publish, discuss, and discover books together."
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_TIMEZONE=America/Bahia
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

# ------------------------------------------------------------------------------
# Authentication and encryption
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=12
AUTH_PASSWORD_TIMEOUT=10800

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database
# DB_ROOT_PASSWORD is used only by Docker Compose.
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=draftcircle
DB_USERNAME=draftcircle
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# Sessions
# Set SESSION_SECURE_COOKIE=true when the application is served over HTTPS.
# ------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_CONNECTION=default
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# ------------------------------------------------------------------------------
# Cache, queues, broadcasting, and storage
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

CACHE_STORE=redis
CACHE_PREFIX=draftcircle_cache_
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------------------
# Realtime broadcasting
# Browser traffic reaches Reverb through Nginx on the same application port.
# ------------------------------------------------------------------------------
REVERB_APP_ID=draftcircle
REVERB_APP_KEY=draftcircle-local-key
REVERB_APP_SECRET=draftcircle-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false

# ------------------------------------------------------------------------------
# Mail
# Mailpit is available at http://localhost:8025 during local development.
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@draftcircle.local"
MAIL_FROM_NAME="DraftCircle"

# ------------------------------------------------------------------------------
# Observability and queue monitoring
# Disable Telescope outside trusted development environments.
# ------------------------------------------------------------------------------
TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope
HORIZON_NAME="DraftCircle"
HORIZON_PATH=horizon

# ------------------------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ------------------------------------------------------------------------------
# AWS / S3-compatible storage
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http
