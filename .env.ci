# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME="DraftCircle"
APP_DESCRIPTION="A social writing platform where authors create, publish, discuss, and discover books together."
APP_ENV=testing
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=2

# ------------------------------------------------------------------------------
# Authentication and encryption
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=4
AUTH_PASSWORD_TIMEOUT=10800

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=draftcircle_test
DB_USERNAME=root
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# Sessions, cache, queues, broadcasting, and storage
# Tests use in-memory/sessionless drivers for isolation and speed.
# ------------------------------------------------------------------------------
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_CONNECTION=null
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

CACHE_STORE=array
CACHE_PREFIX=draftcircle_test_cache_
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Redis
# Redis remains available in CI for integration checks when needed.
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_CLIENT=predis
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------------------
# Realtime broadcasting
# Broadcasting remains logged in CI, but matching keys validate configuration.
# ------------------------------------------------------------------------------
REVERB_APP_ID=draftcircle-ci
REVERB_APP_KEY=draftcircle-ci-key
REVERB_APP_SECRET=draftcircle-ci-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false

# ------------------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------------------
MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@draftcircle.local"
MAIL_FROM_NAME="DraftCircle"

# ------------------------------------------------------------------------------
# Observability and queue monitoring
# ------------------------------------------------------------------------------
TELESCOPE_ENABLED=false
TELESCOPE_PATH=telescope
HORIZON_NAME="DraftCircle CI"
HORIZON_PATH=horizon

# ------------------------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ------------------------------------------------------------------------------
# AWS / S3-compatible storage
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http
